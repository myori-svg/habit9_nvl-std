{
  "name": "novel-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "fix": "biome check --write ./app ./components ./lib ./types",
    "fix:unsafe": "biome check --write --unsafe ./app ./components ./lib ./types",
    "check:types": "tsc --noEmit",
    "check:format": "biome format ./app ./components ./lib ./types",
    "check:unused": "biome check --reporter=summary ./app ./components ./lib ./types",
    "check-all": "yarn check:types && yarn check:format && yarn check:unused",
    "fix-all": "yarn fix && yarn check:types"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "firebase": "^11.0.0",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "next": "15.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
